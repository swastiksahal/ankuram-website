    <!-- How Hybrid Works Section -->
    <section id="how-it-works" class="section bg-light" aria-labelledby="how-works-heading">
        <div class="container">
            <h2 id="how-works-heading" class="section-title">How Hybrid Works</h2>
            <ol style="max-width: 700px; margin: 2rem auto; padding-left: 0; list-style: none; counter-reset: step-counter;">
                <li style="counter-increment: step-counter; margin-bottom: 2rem; padding-left: 3rem; position: relative;">
                    <strong style="display: block; font-size: 1.25rem; color: #1e3a5f; margin-bottom: 0.5rem;">Online:</strong>
                    <span style="color: #4b5563;">Concept clarity + guided practice (weekday sessions)</span>
                    <span style="position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; background: #2563eb; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold;">1</span>
                </li>
                <li style="counter-increment: step-counter; margin-bottom: 2rem; padding-left: 3rem; position: relative;">
                    <strong style="display: block; font-size: 1.25rem; color: #1e3a5f; margin-bottom: 0.5rem;">Offline at Centre:</strong>
                    <span style="color: #4b5563;">Tests, revision, doubt clearing (scheduled)</span>
                    <span style="position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; background: #2563eb; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold;">2</span>
                </li>
                <li style="counter-increment: step-counter; margin-bottom: 2rem; padding-left: 3rem; position: relative;">
                    <strong style="display: block; font-size: 1.25rem; color: #1e3a5f; margin-bottom: 0.5rem;">Weekly Tracking:</strong>
                    <span style="color: #4b5563;">Fix repeated errors early, progress reports</span>
                    <span style="position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; background: #2563eb; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold;">3</span>
                </li>
            </ol>
        </div>
    </section>

    <!-- Disclaimer Section -->
    <section class="section">
        <div class="container">
            <div class="content-item" style="background: #fef3c7; padding: 1.5rem; border-left: 4px solid #f59e0b; border-radius: 4px;">
                <h3 style="color: #92400e; margin-top: 0;">Important: Service Clarification</h3>
                <p style="color: #78350f; margin-bottom: 0;"><strong>Our offline centre is located only in Jubilee Hills.</strong> We do NOT provide home tuition visits (teacher travelling to your home). Online classes are conducted live via video call where students attend from their homes. Centre visits happen at our Jubilee Hills location.</p>
            </div>
        </div>
    </section>

    <!-- FAQs — FIXED: proper wrapper div on all items, 6 unique questions -->
    <section class="faq-section">
        <div class="container">
            <h2 class="section-title">Frequently Asked Questions</h2>
            <div class="faq-accordion">
                <div class="faq-accordion-item">
                    <button class="faq-accordion-header" aria-expanded="false" aria-controls="faq-hybrid-1" id="faq-hybrid-1-question">
                        <span class="faq-accordion-question">Do you have a branch in Gachibowli / Kondapur / Madhapur?</span>
                        <span class="faq-accordion-icon">+</span>
                    </button>
                    <div class="faq-accordion-content" id="faq-hybrid-1" role="region" aria-labelledby="faq-hybrid-1-question" aria-hidden="true" hidden>
                        <p>No. Our centre is in Jubilee Hills only. Hybrid (online + centre visits) is available for all areas.</p>
                    </div>
                </div>
                <div class="faq-accordion-item">
                    <button class="faq-accordion-header" aria-expanded="false" aria-controls="faq-hybrid-2" id="faq-hybrid-2-question">
                        <span class="faq-accordion-question">Do you offer home tuition visits?</span>
                        <span class="faq-accordion-icon">+</span>
                    </button>
                    <div class="faq-accordion-content" id="faq-hybrid-2" role="region" aria-labelledby="faq-hybrid-2-question" aria-hidden="true" hidden>
                        <p>No. We don't do home visits. Online classes or centre sessions only.</p>
                    </div>
                </div>
                <div class="faq-accordion-item">
                    <button class="faq-accordion-header" aria-expanded="false" aria-controls="faq-hybrid-3" id="faq-hybrid-3-question">
                        <span class="faq-accordion-question">Can I do one-on-one online?</span>
                        <span class="faq-accordion-icon">+</span>
                    </button>
                    <div class="faq-accordion-content" id="faq-hybrid-3" role="region" aria-labelledby="faq-hybrid-3-question" aria-hidden="true" hidden>
                        <p>Yes. One-on-one sessions available both online and at the centre.</p>
                    </div>
                </div>
                <div class="faq-accordion-item">
                    <button class="faq-accordion-header" aria-expanded="false" aria-controls="faq-hybrid-4" id="faq-hybrid-4-question">
                        <span class="faq-accordion-question">What grades and curricula do you support?</span>
                        <span class="faq-accordion-icon">+</span>
                    </button>
                    <div class="faq-accordion-content" id="faq-hybrid-4" role="region" aria-labelledby="faq-hybrid-4-question" aria-hidden="true" hidden>
                        <p>Grades 1–12. CBSE, ICSE/ISC, IB MYP, IB DP, IGCSE, A Levels, State Board.</p>
                    </div>
                </div>
                <div class="faq-accordion-item">
                    <button class="faq-accordion-header" aria-expanded="false" aria-controls="faq-hybrid-5" id="faq-hybrid-5-question">
                        <span class="faq-accordion-question">What subjects do you cover?</span>
                        <span class="faq-accordion-icon">+</span>
                    </button>
                    <div class="faq-accordion-content" id="faq-hybrid-5" role="region" aria-labelledby="faq-hybrid-5-question" aria-hidden="true" hidden>
                        <p>We specialize in Mathematics and Physics for CBSE, ICSE, IB (MYP & DP), IGCSE, Cambridge A-Levels, and Telangana State Board, for classes 6-12.</p>
                    </div>
                </div>
                <div class="faq-accordion-item">
                    <button class="faq-accordion-header" aria-expanded="false" aria-controls="faq-hybrid-6" id="faq-hybrid-6-question">
                        <span class="faq-accordion-question">How do I start?</span>
                        <span class="faq-accordion-icon">+</span>
                    </button>
                    <div class="faq-accordion-content" id="faq-hybrid-6" role="region" aria-labelledby="faq-hybrid-6-question" aria-hidden="true" hidden>
                        <p>Book a 90-minute diagnostic assessment — you can do this online or at our centre. This helps us understand your child's current level and create a customized learning plan.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

