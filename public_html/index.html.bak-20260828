    <!-- Hero Section -->
    <section id="home" class="hero">
        <div class="container">
            <div class="hero-content">
                <h1 class="hero-title">Tuition for Grades 1–12 in Jubilee Hills, Hyderabad</h1>
                <p class="hero-subtitle">Small‑batch classes (3–5 students) with a foundation‑first approach across CBSE, ICSE, ISC, IGCSE, IB (MYP/DP), AS & A Levels and State Board.</p>
                <p class="hero-supporting">At ANKURAM, we focus on concept clarity, step‑by‑step problem solving, and consistent practice—so students improve marks and confidence.</p>
                <p class="hero-curricula">CBSE • IB MYP • IGCSE • ICSE • IB DP • AS & A Levels • State Board</p>
                <div class="hero-cta">
                    <a href="#" 
                       class="btn btn-primary btn-large" 
                       id="bookDiagnosticBtn"
                       data-track="cta_click"
                       data-cta-name="book_diagnostic"
                       data-track-location="hero"
                       onclick="trackCTAClick('book_diagnostic', 'hero'); return true;">Book Diagnostic Test</a>
                    <a href="tel:+917396669430" 
                       class="btn btn-secondary btn-large"
                       data-track="phone_call"
                       data-track-location="hero"
                       onclick="trackPhoneClick('hero'); return true;">Call: 73966 69430</a>
                </div>
            </div>
        </div>
    </section>

    <!-- Trust Indicators Bar -->
    <section class="trust-bar">
        <div class="container">
            <div class="trust-indicators">
                <span class="trust-item">✓ 13+ Years Experience</span>
                <span class="trust-item">✓ All Major Curricula</span>
                </div>
                </div>
    </section>

    <!-- Why Choose Us Section -->
    <section class="why-choose-us">
        <div class="container">
            <h2 class="section-title">Why Choose Ankuram Tuition Centre?</h2>
            <div class="why-grid">
                <div class="why-card">
                    <h3>Small Batches (3–5 students)</h3>
                    <p>Personal attention in every class. We track errors, build strong basics, and help students improve steadily—without stress.</p>
                </div>
                <div class="why-card">
                    <h3>All Curricula Supported</h3>
                    <p>CBSE, ICSE, ISC, IGCSE, IB MYP/DP, AS & A Levels, and Telangana/Andhra State Board—taught with the right syllabus + exam approach.</p>
                </div>
                <div class="why-card">
                    <h3>Foundation‑First Learning</h3>
                    <p>We fix conceptual gaps before moving ahead. Clear methods, structured practice, and zero rote‑learning shortcuts.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Subjects We Teach Section -->
    <section class="subjects-section">
        <div class="container">
            <h2 class="section-title">Subjects We Teach</h2>
            <div class="subjects-grid">
                <div class="subject-card">
                    <h3>Maths Tuition Jubilee Hills</h3>
                    <p>Comprehensive mathematics coaching from basics to advanced concepts. We cover algebra, geometry, trigonometry, calculus, and more.</p>
                </div>
