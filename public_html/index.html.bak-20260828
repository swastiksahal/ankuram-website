    <!-- FAQPage Schema -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Do you offer tuition in Jubilee Hills for CBSE, ICSE, IGCSE and IB?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. ANKURAM supports CBSE, ICSE, ISC, IGCSE, IB (MYP/DP), AS & A Levels, and State Board. Teaching style and practice are aligned to the curriculum."
          }
        },
        {
          "@type": "Question",
          "name": "What grades do you teach?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We teach Grades 1–12. Grades 1–5 include all subjects + homework help (English & Maths focus). Grades 6–10 focus mainly on Maths (Science optional). Grades 11–12 cover Maths, Physics and Chemistry."
          }
        },
        {
          "@type": "Question",
          "name": "What is your batch size?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Our classes are small batches of 3–5 students, allowing personal attention, error correction, and steady improvement."
          }
        },
        {
          "@type": "Question",
          "name": "Do you take Class 10 tuition in Hyderabad?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. We support Class 10 with concept strengthening, practice sets, and exam readiness—especially for Maths (and Science if required)."
          }
        },
        {
          "@type": "Question",
          "name": "Do you offer Class 12 Maths / Physics / Chemistry tuition in Hyderabad?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. For Grades 11–12, we teach Maths, Physics and Chemistry with structured practice and revision support."
          }
        },
        {
          "@type": "Question",
          "name": "I'm searching \"maths tuition near me\"—are you close to Banjara Hills / Film Nagar / Madhapur?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We are located in Jubilee Hills and commonly serve students from Banjara Hills, Film Nagar, Madhapur and nearby areas."
          }
        },
        {
          "@type": "Question",
          "name": "How do I know which program to choose?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Use \"Find Your Program\" to select Grade + Subject + Curriculum. Or call/WhatsApp us and we'll recommend the right batch based on current level and school syllabus."
          }
        },
        {
          "@type": "Question",
          "name": "What are the tuition timings and fees?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Timings depend on grade and current batch availability. Fees vary by grade, subject, and frequency. Contact us for the latest schedule and fee structure."
          }
        },
        {
          "@type": "Question",
          "name": "Do you offer tuition in Gachibowli?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Students from Gachibowli learn with us through online weekday classes and weekend sessions at our Jubilee Hills centre. The 20-25 minute weekend drive works well for most families."
          }
        },
        {
          "@type": "Question",
          "name": "Is there tuition available in KPHB?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Students from KPHB attend online classes during the week and come to our Jubilee Hills centre on weekends for in-person sessions."
          }
        },
        {
          "@type": "Question",
          "name": "Do you have a branch in Financial District?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We have one centre in Jubilee Hills. Students from Financial District join online classes on weekdays and attend weekend sessions at our centre."
          }
        },
        {
          "@type": "Question",
          "name": "How do online classes work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Live small-batch sessions (3-5 students) with real-time interaction. Students solve problems, share photos via WhatsApp, and get immediate corrections from the teacher."
          }
        },
        {
          "@type": "Question",
          "name": "Is online as good as offline?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For regular practice and concept learning, yes. Weekend offline sessions add depth — tests, intensive revision, and in-person doubt-clearing. The combination works better than either alone."
          }
        },
        {
          "@type": "Question",
          "name": "Do you offer tuition in Gachibowli?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Students from Gachibowli learn with us through online weekday classes and weekend sessions at our Jubilee Hills centre. It's a 20-25 minute drive on weekends."
          }
        },
        {
          "@type": "Question",
          "name": "Is there tuition available in KPHB?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, students from KPHB attend our online classes during the week and come to our Jubilee Hills centre on weekends for in-person sessions."
          }
        },
        {
          "@type": "Question",
          "name": "Do you have a branch in Financial District?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We have one centre in Jubilee Hills. Students from Financial District join online classes on weekdays and attend weekend sessions at our centre."
          }
        },
        {
          "@type": "Question",
          "name": "Can students from Secunderabad join?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Several students from Secunderabad learn with us through our hybrid model — online during the week, offline on weekends."
          }
        }
      ]
    }
    </script>
    
