    <!-- How We Teach Section -->
    <section class="how-we-teach">
        <div class="container">
            <h2 class="section-title">How We Teach at ANKURAM</h2>
            <p class="section-intro">At Ankuram Tuition Centre in Jubilee Hills, our teaching is built around one goal: deep understanding + reliable exam performance. Every student follows a simple learning cycle:</p>
            
            <div class="teaching-cycle-timeline">
                <div class="timeline-step">
