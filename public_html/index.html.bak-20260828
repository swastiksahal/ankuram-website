    <script src="script.js"></script>
    
    <!-- ============================================
         ANKURAM Conversion Tracking Script
         ============================================ -->
    <script>
    // Initialize dataLayer
        window.dataLayer = window.dataLayer || [];

    // Enable debug mode (set to false in production)
    // TODO: Set to false before deploying to production
    const DEBUG_TRACKING = false;

    // --------------------------------------------
    // PHONE CALL TRACKING
    // --------------------------------------------
    function trackPhoneClick(location) {
      // Google Analytics 4 Event
      if (typeof gtag !== 'undefined') {
        gtag('event', 'phone_call_click', {
          'event_category': 'contact',
          'event_label': location,
          'value': 1
        });
      }
      
      // Data Layer for GTM
      dataLayer.push({
        'event': 'phone_call',
        'eventCategory': 'Contact',
        'eventAction': 'Phone Call Click',
        'eventLabel': location,
        'conversionType': 'primary'
      });
      
      // Console log for debugging
      if (DEBUG_TRACKING) {
        console.log('%cPhone click tracked: ' + location, 'background: #22c55e; color: white; padding: 4px 8px; border-radius: 4px;');
      }
    }

    // --------------------------------------------
    // WHATSAPP TRACKING
    // --------------------------------------------
    function trackWhatsAppClick(location) {
      // Google Analytics 4 Event
      if (typeof gtag !== 'undefined') {
        gtag('event', 'whatsapp_click', {
          'event_category': 'contact',
          'event_label': location,
          'value': 1
        });
      }
      
      // Data Layer for GTM
      dataLayer.push({
        'event': 'whatsapp_click',
        'eventCategory': 'Contact',
        'eventAction': 'WhatsApp Click',
        'eventLabel': location,
        'conversionType': 'primary'
      });
      
      if (DEBUG_TRACKING) {
        console.log('%cWhatsApp click tracked: ' + location, 'background: #22c55e; color: white; padding: 4px 8px; border-radius: 4px;');
      }
    }

    // --------------------------------------------
    // FORM SUBMISSION TRACKING
    // --------------------------------------------
    function trackFormSubmission(formName, formElement) {
      // Prevent default to track before submission
      if (event) {
        event.preventDefault();
      }
      
      // Get form data
      const formData = new FormData(formElement);
      const grade = formData.get('grade') || 'not_specified';
      const curriculum = formData.get('curriculum') || 'not_specified';
      const subject = formData.get('subject') || 'not_specified';
      const name = formData.get('name') || 'not_specified';
      
      // Google Analytics 4 Event
      if (typeof gtag !== 'undefined') {
        gtag('event', 'form_submission', {
          'event_category': 'conversion',
          'event_label': formName,
          'form_name': formName,
          'grade': grade,
          'curriculum': curriculum,
          'subject': subject,
          'value': formName === 'diagnostic_test' ? 750 : 200
        });
      }
      
      // Data Layer for GTM
      dataLayer.push({
        'event': 'form_submission',
        'eventCategory': 'Conversion',
        'eventAction': 'Form Submission',
        'eventLabel': formName,
        'formName': formName,
        'grade': grade,
        'curriculum': curriculum,
        'subject': subject,
        'conversionType': 'primary',
        'conversionValue': formName === 'diagnostic_test' ? 750 : 200
      });
      
      if (DEBUG_TRACKING) {
        console.log('%cForm submission tracked: ' + formName, 'background: #22c55e; color: white; padding: 4px 8px; border-radius: 4px;');
        console.log('Form data:', { grade, curriculum, subject });
      }
      
      // Submit form after tracking (with slight delay to ensure tracking fires)
      setTimeout(function() {
        // Call the existing form handler function if it exists
        if (typeof handleFormSubmit === 'function') {
          const fakeEvent = { preventDefault: function() {} };
          handleFormSubmit(fakeEvent);
        } else {
          // Fallback: trigger submit event
          const submitEvent = new Event('submit', { bubbles: true, cancelable: true });
          formElement.dispatchEvent(submitEvent);
        }
      }, 300);
      
      return false; // Prevent default submission
    }

    // --------------------------------------------
    // CTA BUTTON TRACKING
    // --------------------------------------------
    function trackCTAClick(ctaName, location) {
      // Google Analytics 4 Event
      if (typeof gtag !== 'undefined') {
        gtag('event', 'cta_click', {
          'event_category': 'engagement',
          'event_label': ctaName,
          'cta_location': location
        });
      }
      
      // Data Layer for GTM
      dataLayer.push({
        'event': 'cta_click',
        'eventCategory': 'Engagement',
        'eventAction': 'CTA Click',
        'eventLabel': ctaName,
        'ctaLocation': location,
        'conversionType': 'micro'
      });
      
      if (DEBUG_TRACKING) {
        console.log('%cCTA click tracked: ' + ctaName + ' (' + location + ')', 'background: #3b82f6; color: white; padding: 4px 8px; border-radius: 4px;');
      }
    }

    // --------------------------------------------
    // CURRICULUM PAGE TRACKING
    // --------------------------------------------
    function trackCurriculumClick(curriculum) {
      // Google Analytics 4 Event
      if (typeof gtag !== 'undefined') {
        gtag('event', 'curriculum_click', {
          'event_category': 'navigation',
          'event_label': curriculum
        });
      }
      
      // Data Layer for GTM
      dataLayer.push({
        'event': 'curriculum_click',
        'eventCategory': 'Navigation',
        'eventAction': 'Curriculum Page Click',
        'eventLabel': curriculum
      });
      
      if (DEBUG_TRACKING) {
        console.log('%cCurriculum click tracked: ' + curriculum, 'background: #8b5cf6; color: white; padding: 4px 8px; border-radius: 4px;');
      }
    }

    // --------------------------------------------
    // SCROLL DEPTH TRACKING
    // --------------------------------------------
    let scrollTracked = {
      '25': false,
      '50': false,
      '75': false,
      '90': false
    };

    window.addEventListener('scroll', function() {
      const scrollPercent = Math.round((window.scrollY / (document.documentElement.scrollHeight - window.innerHeight)) * 100);
      
      const thresholds = ['25', '50', '75', '90'];
      
      thresholds.forEach(function(threshold) {
        if (scrollPercent >= parseInt(threshold) && !scrollTracked[threshold]) {
          scrollTracked[threshold] = true;
          
          if (typeof gtag !== 'undefined') {
            gtag('event', 'scroll_depth', {
              'event_category': 'engagement',
              'event_label': threshold + '%',
              'value': parseInt(threshold)
            });
          }
          
          dataLayer.push({
            'event': 'scroll_depth',
            'scrollDepth': threshold
          });
          
          if (DEBUG_TRACKING) {
            console.log('%cScroll depth tracked: ' + threshold + '%', 'background: #f59e0b; color: white; padding: 4px 8px; border-radius: 4px;');
          }
        }
      });
    }, { passive: true });

    // --------------------------------------------
    // TIME ON SITE TRACKING
    // --------------------------------------------
    let timeTracked = {
      '30': false,
      '60': false,
      '120': false,
      '300': false
    };

    const timeLabels = {
      '30': '30_seconds',
      '60': '1_minute',
      '120': '2_minutes',
      '300': '5_minutes'
    };

    let startTime = Date.now();

    setInterval(function() {
      const timeOnSite = Math.floor((Date.now() - startTime) / 1000);
      
      Object.keys(timeTracked).forEach(function(threshold) {
        if (timeOnSite >= parseInt(threshold) && !timeTracked[threshold]) {
          timeTracked[threshold] = true;
          
          if (typeof gtag !== 'undefined') {
            gtag('event', 'time_on_site', {
              'event_category': 'engagement',
              'event_label': timeLabels[threshold],
              'value': parseInt(threshold)
            });
          }
          
          dataLayer.push({
            'event': 'time_on_site',
            'timeOnSite': timeLabels[threshold]
          });
          
          if (DEBUG_TRACKING) {
            console.log('%cTime on site tracked: ' + timeLabels[threshold], 'background: #ec4899; color: white; padding: 4px 8px; border-radius: 4px;');
          }
        }
      });
    }, 5000); // Check every 5 seconds

    // --------------------------------------------
    // OUTBOUND LINK TRACKING
    // --------------------------------------------
    document.addEventListener('click', function(e) {
      const link = e.target.closest('a');
      if (link && link.hostname && link.hostname !== window.location.hostname && !link.hostname.includes('wa.me') && !link.hostname.includes('maps')) {
        if (typeof gtag !== 'undefined') {
          gtag('event', 'outbound_click', {
            'event_category': 'outbound',
            'event_label': link.href
          });
        }
        
        dataLayer.push({
          'event': 'outbound_click',
          'outboundUrl': link.href
        });
        
        if (DEBUG_TRACKING) {
          console.log('%cOutbound link tracked: ' + link.href, 'background: #ef4444; color: white; padding: 4px 8px; border-radius: 4px;');
        }
      }
    });

    // --------------------------------------------
    // ERROR TRACKING
    // --------------------------------------------
    window.addEventListener('error', function(e) {
      if (typeof gtag !== 'undefined') {
        gtag('event', 'javascript_error', {
          'event_category': 'error',
          'event_label': e.message,
          'error_file': e.filename,
          'error_line': e.lineno
        });
      }
      
      dataLayer.push({
        'event': 'javascript_error',
        'errorMessage': e.message,
        'errorFile': e.filename,
        'errorLine': e.lineno
      });
    });

    if (DEBUG_TRACKING) {
      console.log('%cANKURAM tracking script loaded', 'background: #1e3a5f; color: white; padding: 6px 12px; border-radius: 4px; font-weight: bold;');
    }
    </script>
</body>
</html>
