                    <!-- Contact Form -->
                    <form class="contact-form" 
                          id="contactForm"
                          data-track="form_submission"
                          data-form-name="contact"
                          onsubmit="return trackFormSubmission('contact', this);">
                        <p class="form-microcopy">Share your student's grade and current curriculum (IB, IGCSE, Cambridge A-Levels, or CBSE). We will get back to you within 2 hours to schedule a comprehensive Diagnostic Assessment (₹750).</p>
                    <div class="form-group">
                            <label for="name">Name *</label>
                            <input type="text" id="name" name="name" required>
                    </div>
                    <div class="form-group">
                            <label for="phone">Phone *</label>
                            <input type="tel" id="phone" name="phone" required>
                    </div>
                    <div class="form-group">
                            <label for="grade">Grade</label>
                            <select id="grade" name="grade">
                            <option value="">Select Grade</option>
                                <option value="1-5">Grades 1-5</option>
                                <option value="6-10">Grades 6-10</option>
                                <option value="11-12">Grades 11-12</option>
                        </select>
                    </div>
                    <div class="form-group">
                            <label for="curriculum">Curriculum</label>
                            <select id="curriculum" name="curriculum">
                            <option value="">Select Curriculum</option>
                            <option value="cbse">CBSE</option>
                                <option value="ib-myp">IB MYP</option>
                                <option value="igcse">IGCSE</option>
                            <option value="icse">ICSE</option>
                                <option value="isc">ISC</option>
                                <option value="ib-dp">IB DP</option>
                                <option value="as-a-levels">AS & A Levels</option>
                                <option value="state-board">State Board</option>
                        </select>
                    </div>
                        <div class="form-group">
                            <label for="message">Message</label>
                            <textarea id="message" name="message" rows="4"></textarea>
                </div>
                        <button type="submit" class="btn btn-primary">Send Message</button>
                    </form>
                
                </div>
                
            </div>
            
