# Topics directory - Allow static HTML files
RewriteEngine On

# Directory index
DirectoryIndex index.html index.htm

# Allow direct file access (bypass any parent rewrites)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^(.*)$ - [L]

# Allow directory access - serve index.html
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*)$ $1/index.html [L]

# Explicitly allow HTML files
<FilesMatch "\.html$">
    Order allow,deny
    Allow from all
</FilesMatch>
